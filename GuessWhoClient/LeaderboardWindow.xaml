<Window x:Class="GuessWhoClient.LeaderboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:localization="clr-namespace:GuessWhoClient.Globalization"
        mc:Ignorable="d"
        Title="LeaderboardWindow"
        Height="720" Width="1120"
        Background="{StaticResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/PixelTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="VisibilityByNullStyle" TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding MyStats}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Brush.Card}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDark}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="Txt.Title" TargetType="TextBlock" BasedOn="{StaticResource Txt.Pixel}">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <Style x:Key="Btn.Icon" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource Brush.TextLight}" />
                <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDark}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="FontFamily" Value="{StaticResource Font.Pixel}" />
                <Setter Property="Padding" Value="8,6" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.Card}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter Property="Opacity" Value="0.9" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="60" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="40"
                       VerticalAlignment="Center"
                       Text="{Binding [LblLeaderboard], Source={x:Static localization:LocalizationProvider.Instance}, FallbackValue='LEADERBOARD'}" />

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.Icon}"
                        Margin="6,0"
                        Width="60"
                        ToolTip="Actualizar"
                        Click="BtnRefresh_Click">
                    <TextBlock Text="↻" FontSize="24" FontWeight="Bold" Margin="0,-4,0,0"/>
                </Button>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1"
                Margin="0,10,0,10"
                Style="{StaticResource Card}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="{Binding [LblTopPlayers], Source={x:Static localization:LocalizationProvider.Instance}, FallbackValue='MEJORES JUGADORES'}"
                           Style="{StaticResource Txt.Title}" 
                           FontSize="20"
                           Foreground="{StaticResource Brush.Accent}"/>

                <ScrollViewer Grid.Row="1" 
                              VerticalScrollBarVisibility="Auto" 
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,0">

                    <ItemsControl ItemsSource="{Binding TopPlayers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Height="72"
                                        Background="{StaticResource Brush.Panel}"
                                        BorderBrush="{StaticResource Brush.AccentDark}"
                                        BorderThickness="2"
                                        CornerRadius="10"
                                        Padding="8">

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="50" />
                                            <ColumnDefinition Width="70" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="{Binding Rank, StringFormat='#{0}'}"
                                                   Style="{StaticResource Txt.Pixel}"
                                                   FontSize="20"
                                                   VerticalAlignment="Center"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextLight}"
                                                   Opacity="0.7"/>

                                        <Border Grid.Column="1"
                                                Width="56" Height="56"
                                                CornerRadius="8"
                                                BorderBrush="{StaticResource Brush.AccentDark}"
                                                BorderThickness="2"
                                                Margin="0,0,10,0"
                                                Background="{StaticResource Brush.Bg}">
                                            <Image Source="{Binding AvatarId}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Grid.Column="2"
                                                   Text="{Binding DisplayName}"
                                                   Style="{StaticResource Txt.Pixel}"
                                                   FontSize="22"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>

                                        <Border Grid.Column="3"
                                                Background="{StaticResource Brush.Bg}"
                                                CornerRadius="6"
                                                Padding="12,4"
                                                BorderBrush="{StaticResource Brush.Accent}"
                                                BorderThickness="1"
                                                Margin="0,0,8,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="🏆" 
                                                           FontSize="16" 
                                                           VerticalAlignment="Center" 
                                                           Margin="0,0,6,0"/>

                                                <TextBlock Text="{Binding Wins}"
                                                           Style="{StaticResource Txt.Pixel}"
                                                           FontSize="20"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           VerticalAlignment="Center"/>

                                                <TextBlock Text=" WIN"
                                                           Style="{StaticResource Txt.Pixel}"
                                                           FontSize="14"
                                                           Foreground="{StaticResource Brush.Accent}"
                                                           VerticalAlignment="Center"
                                                           Margin="2,2,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>

                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,10,0,10"
                Style="{StaticResource VisibilityByNullStyle}" 
                BorderBrush="{StaticResource Brush.Accent}"
                Background="{StaticResource Brush.AccentDark}">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="{Binding [LblYourPosition], Source={x:Static localization:LocalizationProvider.Instance}, FallbackValue='TU POSICIÓN:'}" 
                           Style="{StaticResource Txt.Pixel}" 
                           VerticalAlignment="Center" 
                           Margin="10,0,20,0"
                           Foreground="{StaticResource Brush.TextLight}"/>

                <Grid Grid.Column="1" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="{Binding MyStats.Rank, StringFormat='#{0}'}"
                               Style="{StaticResource Txt.Pixel}"
                               FontSize="20"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               Foreground="White"/>

                    <Border Grid.Column="1"
                            Width="56" Height="56"
                            CornerRadius="8"
                            BorderBrush="{StaticResource Brush.AccentDark}"
                            BorderThickness="2"
                            Margin="0,0,10,0"
                            Background="{StaticResource Brush.Bg}">
                        <Image Source="{Binding MyStats.AvatarId}" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Grid.Column="2"
                               Text="{Binding MyStats.DisplayName}"
                               Style="{StaticResource Txt.Pixel}"
                               FontSize="22"
                               VerticalAlignment="Center"
                               Foreground="White"/>

                    <Border Grid.Column="3"
                            Background="{StaticResource Brush.Bg}"
                            CornerRadius="6"
                            Padding="12,4"
                            BorderBrush="{StaticResource Brush.Accent}"
                            BorderThickness="1"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🏆" FontSize="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding MyStats.Wins}"
                                       Style="{StaticResource Txt.Pixel}"
                                       FontSize="20"
                                       Foreground="{StaticResource Brush.Accent}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="btnBack"
                Grid.Row="3"
                Content="{Binding [BtnBack], Source={x:Static localization:LocalizationProvider.Instance}, FallbackValue='Back'}"
                Style="{StaticResource Btn.Play.Left}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Click="btnBack_Click" />
    </Grid>
</Window>