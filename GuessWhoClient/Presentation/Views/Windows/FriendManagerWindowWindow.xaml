<Window x:Class="WPFGuessWhoClient.FriendManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:lang="clr-namespace:ClassLibraryGuessWho.Properties.Localization;assembly=ClassLibraryGuessWho"
        mc:Ignorable="d"
        Title="{x:Static lang:Common.FriendErrorTitle}"
        Height="650"
        Width="1000"
        Background="{StaticResource Brush.Bg}"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/PixelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CardFriendManager" TargetType="GroupBox">
                <Setter Property="Padding" Value="10"/>
                <Setter Property="Foreground" Value="{StaticResource Brush.TextLight}"/>
                <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDark}"/>
                <Setter Property="BorderThickness" Value="2"/>
                <Setter Property="Background" Value="{StaticResource Brush.Card}"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="16"
                Background="{StaticResource Brush.Bg}"
                BorderBrush="{StaticResource Brush.AccentDark}"
                BorderThickness="3"
                Padding="20"
                Width="980"
                MaxHeight="620">

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de búsqueda -->
                    <StackPanel Orientation="Horizontal"
                                Grid.Row="0"
                                Margin="0,0,0,16">

                        <TextBox x:Name="txtSearch"
                                 Width="360"
                                 Height="34"
                                 Margin="0,0,8,0"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                        <Button x:Name="btnSearch"
                                Width="120"
                                Content="{x:Static lang:Common.BtnSearch}"
                                Style="{StaticResource Btn.Primary}"
                                Command="{Binding SearchProfilesCommand}"/>

                        <Button x:Name="btnRefresh"
                                Width="160"
                                Margin="8,0,0,0"
                                Content="{x:Static lang:Common.BtnRefresh}"
                                Style="{StaticResource Btn.Primary}"
                                Command="{Binding LoadFriendsCommand}"/>
                    </StackPanel>

                    <!-- Contenido -->
                    <Grid Grid.Row="1" MinHeight="250">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Resultados de búsqueda -->
                        <GroupBox Grid.Column="0"
                                  Header="{x:Static lang:Common.HeaderSearchResults}"
                                  Style="{StaticResource CardFriendManager}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <DataGrid x:Name="dgvProfiles"
                                          Grid.Row="0"
                                          AutoGenerateColumns="False"
                                          ItemsSource="{Binding SearchResults}"
                                          SelectedItem="{Binding SelectedProfile}"
                                          Margin="4">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*"
                                                            Header="{x:Static lang:Common.ColUsername}"
                                                            Binding="{Binding DisplayName}"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <Button x:Name="btnSendRequest"
                                        Grid.Row="1"
                                        Margin="0,8,4,4"
                                        HorizontalAlignment="Right"
                                        Content="{x:Static lang:Common.BtnSendRequest}"
                                        Style="{StaticResource Btn.Primary}"
                                        Command="{Binding SendFriendRequestCommand}"/>
                            </Grid>
                        </GroupBox>

                        <!-- Amigos -->
                        <GroupBox Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Header="{x:Static lang:Common.HeaderMyFriends}"
                                  Style="{StaticResource CardFriendManager}">
                            <DataGrid x:Name="dgvFriends"
                                      AutoGenerateColumns="False"
                                      ItemsSource="{Binding Friends}"
                                      Margin="4">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="*"
                                                        Header="{x:Static lang:Common.ColUsername}"
                                                        Binding="{Binding DisplayName}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </Grid>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
