<Window x:Class="GuessWhoClient.Presentation.Views.Windows.GameMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:GuessWhoClient.Windows"
        Title="Message"
        Height="220"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border Background="{StaticResource Brush.Bg}"
        BorderBrush="{StaticResource Brush.AccentDark}"
        BorderThickness="3"
        CornerRadius="18"
        Padding="12"
        SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                   Text="{Binding MessageTitle}"
                   Style="{StaticResource Txt.Pixel}"
                   FontSize="24"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,8" />

            <Grid Grid.Row="1"
              Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Path Data="{StaticResource Geo.Mascot.Bulbito.Hello}"
                      Stretch="Uniform"
                      Fill="{StaticResource Brush.Accent}" 
                      Grid.ColumnSpan="2" Margin="0,-32,316,-38" />

                <TextBlock Grid.Column="1"
                       Text="{Binding MessageText}"
                       TextWrapping="Wrap"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="16"
                       Foreground="{StaticResource Brush.TextLight}"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextAlignment="Center" />
            </Grid>

            <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
                <Button Content="OK"
                    Width="120"
                    Height="40"
                    Style="{StaticResource Btn.Primary}"
                    Click="BtnOk_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
