<Window x:Class="GuessWhoClient.Presentation.Views.Windows.GameMessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Message"
        Height="220"
        Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="False">

    <Border Background="{StaticResource Brush.Bg}"
            BorderBrush="{StaticResource Brush.AccentDark}"
            BorderThickness="3"
            CornerRadius="18"
            Padding="12"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding MessageTitle}"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8" />

            <Grid Grid.Row="1" Margin="0,10,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              MaxHeight="100">
                    <TextBlock Text="{Binding MessageText}"
                               TextWrapping="Wrap"
                               Style="{StaticResource Txt.Pixel}"
                               FontSize="16"
                               Foreground="{StaticResource Brush.TextLight}"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </ScrollViewer>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">

                <Button Width="120"
                        Height="40"
                        Margin="0,0,8,0"
                        Content="{Binding SecondaryButtonText}"
                        Click="BtnSecondaryClick">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Primary}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSecondaryButton}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>


                <Button Width="120"
                        Height="40"
                        Style="{StaticResource Btn.Primary}"
                        Content="{Binding PrimaryButtonText}"
                        Click="BtnPrimaryClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
