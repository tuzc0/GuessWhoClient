<UserControl x:Class="GuessWhoClient.Presentation.Views.Leaderboard.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1120">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Themes/PixelTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="VisibilityByNullStyle" TargetType="Border">
                <Setter Property="Visibility" Value="Visible" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding CurrentUserStats}" Value="{x:Null}">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="24,24,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" CornerRadius="16" Padding="12" HorizontalAlignment="Stretch" Margin="15,0,15,10">
            <Grid>
                <Viewbox Stretch="Uniform" MaxHeight="60" HorizontalAlignment="Left">
                    <TextBlock Style="{StaticResource Txt.Pixel}" Text="LEADERBOARD" Foreground="{StaticResource Brush.Accent}"/>
                </Viewbox>

                <Button Style="{StaticResource Btn.Primary}" HorizontalAlignment="Right" Width="50" Height="50"
                        Command="{Binding LoadLeaderboardCommand}">
                    <TextBlock Text="↻" FontSize="24" Margin="0,-4,0,0"/>
                </Button>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="15,10,15,10" CornerRadius="16" Padding="20" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.AccentDark}" BorderThickness="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Text="TOP PLAYERS" Style="{StaticResource Txt.Pixel}" FontSize="20" Margin="0,0,0,15" Foreground="{StaticResource Brush.Accent}"/>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,10,0">
                    <ItemsControl ItemsSource="{Binding LeaderboardEntries}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8" Height="70" Background="{StaticResource Brush.Bg}"
                                        BorderBrush="{StaticResource Brush.AccentDark}" BorderThickness="2" CornerRadius="10" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Rank, StringFormat='#{0}'}" Style="{StaticResource Txt.Pixel}"
                                                   FontSize="22" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextLight}" Opacity="0.8"/>

                                        <Border Grid.Column="1" Width="48" Height="48" CornerRadius="6" Background="{StaticResource Brush.Card}" Margin="0,0,15,0">
                                            <Image Source="{Binding AvatarId}" Stretch="UniformToFill"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding DisplayName}" Style="{StaticResource Txt.Pixel}" FontSize="22"
                                                   VerticalAlignment="Center" Foreground="White"/>

                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="🏆" FontSize="18" Margin="0,0,8,0"/>
                                            <TextBlock Text="{Binding Wins}" Style="{StaticResource Txt.Pixel}" FontSize="22" Foreground="{StaticResource Brush.Accent}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="2" Margin="15,5,15,20" Style="{StaticResource VisibilityByNullStyle}" CornerRadius="12" Padding="15,10"
                Background="{StaticResource Brush.AccentDark}" BorderBrush="{StaticResource Brush.Accent}" BorderThickness="2">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="YOUR POSITION:" Style="{StaticResource Txt.Pixel}" FontSize="18" VerticalAlignment="Center" Margin="0,0,20,0" Foreground="{StaticResource Brush.TextLight}"/>

                <Grid Grid.Column="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="60" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CurrentUserStats.Rank, StringFormat='#{0}'}" Style="{StaticResource Txt.Pixel}"
                               FontSize="22" VerticalAlignment="Center" Foreground="White"/>

                    <Border Grid.Column="1" Width="48" Height="48" CornerRadius="6" Background="{StaticResource Brush.Card}" Margin="0,0,15,0">
                        <Image Source="{Binding CurrentUserStats.AvatarId}" Stretch="UniformToFill"/>
                    </Border>

                    <TextBlock Grid.Column="2" Text="{Binding CurrentUserStats.DisplayName}" Style="{StaticResource Txt.Pixel}" FontSize="22"
                               VerticalAlignment="Center" Foreground="White"/>

                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="🏆" FontSize="18" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CurrentUserStats.Wins}" Style="{StaticResource Txt.Pixel}" FontSize="22" Foreground="{StaticResource Brush.Accent}"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Button x:Name="btnBack" Grid.Row="3" Style="{StaticResource Btn.Primary}" Content="BACK" Width="160" Height="45"
                HorizontalAlignment="Left" Margin="15,0,0,24" Click="btnBack_Click"/>
    </Grid>
</UserControl>