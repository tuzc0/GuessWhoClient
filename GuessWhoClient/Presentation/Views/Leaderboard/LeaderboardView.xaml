<UserControl x:Class="GuessWhoClient.Presentation.Views.Leaderboard.LeaderboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:localization="clr-namespace:GuessWhoClient.Globalization"
             mc:Ignorable="d" 
             d:DesignHeight="720" d:DesignWidth="1120">

    <Border CornerRadius="20"
            Background="#34495E"
            Padding="25"
            Margin="40"
            BorderBrush="#3498DB"
            BorderThickness="2"
            Panel.ZIndex="2">

        <Grid Background="{StaticResource Brush.Bg}"
              Opacity="0.88"
              Margin="-25">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="{Binding [LblLeaderboard], Source={x:Static localization:LocalizationProvider.Instance}}"
                       Style="{StaticResource Txt.Pixel}"
                       Foreground="{StaticResource Brush.Accent}"
                       FontSize="40"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,20" />

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="30,0,30,0">
                <ItemsControl ItemsSource="{Binding TopPlayers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,10"
                                    Height="75"
                                    Background="#34495E"
                                    BorderBrush="#3498DB"
                                    BorderThickness="2"
                                    CornerRadius="10"
                                    Padding="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="70" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" 
                                               Text="{Binding Rank, StringFormat='#{0}'}" 
                                               Style="{StaticResource Txt.Pixel}" 
                                               FontSize="22" 
                                               VerticalAlignment="Center" 
                                               HorizontalAlignment="Center" 
                                               Foreground="White" Opacity="0.8"/>

                                    <Border Grid.Column="1" Width="55" Height="55" CornerRadius="5" Background="{StaticResource Brush.Bg}">
                                        <Image Source="{Binding AvatarId}" Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock Grid.Column="2" 
                                               Text="{Binding DisplayName}" 
                                               Style="{StaticResource Txt.Pixel}" 
                                               FontSize="24" 
                                               Margin="15,0,0,0"
                                               VerticalAlignment="Center" 
                                               Foreground="White"/>

                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                                        <TextBlock Text="🏆" FontSize="20" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Wins}" Style="{StaticResource Txt.Pixel}" FontSize="24" Foreground="{StaticResource Brush.Accent}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" 
                    Margin="30,15,30,15" 
                    Padding="15"
                    Background="#2C3E50" 
                    BorderBrush="{StaticResource Brush.Accent}" 
                    BorderThickness="2" 
                    CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="{Binding [LblYourPosition], Source={x:Static localization:LocalizationProvider.Instance}}" 
                               Style="{StaticResource Txt.Pixel}" Foreground="White" FontSize="18" VerticalAlignment="Center" Margin="10,0,25,0"/>

                    <Grid Grid.Column="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding MyStats.Rank, StringFormat='#{0}'}" Style="{StaticResource Txt.Pixel}" FontSize="20" VerticalAlignment="Center" Foreground="White"/>
                        <Image Grid.Column="1" Source="{Binding MyStats.AvatarId}" Width="45" Height="45" HorizontalAlignment="Left"/>
                        <TextBlock Grid.Column="2" Text="{Binding MyStats.DisplayName}" Style="{StaticResource Txt.Pixel}" FontSize="22" VerticalAlignment="Center" Foreground="White"/>
                        <TextBlock Grid.Column="3" Text="{Binding MyStats.Wins, StringFormat='{}🏆 {0}'}" Style="{StaticResource Txt.Pixel}" FontSize="22" Foreground="{StaticResource Brush.Accent}" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,0,30,25">

                <Button Content="{Binding [BtnBack], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Style="{StaticResource Btn.Primary}"
                        Width="140"
                        Height="50"
                        Click="btnBack_Click" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>