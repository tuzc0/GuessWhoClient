<UserControl x:Class="GuessWhoClient.Presentation.Views.Menu.MainMenuView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:localization="clr-namespace:GuessWhoClient.Globalization">

    <UserControl.Resources>
        <CornerRadius x:Key="MainMenu.BorderCornerRadius">30</CornerRadius>
        <Thickness x:Key="MainMenu.BorderPadding">40</Thickness>

        <sys:Double x:Key="MainMenu.ContainerMinWidth">320</sys:Double>
        <sys:Double x:Key="MainMenu.TitleFontSize">64</sys:Double>

        <sys:Double x:Key="MainMenu.ButtonMinWidth">300</sys:Double>
        <sys:Double x:Key="MainMenu.ButtonHeight">80</sys:Double>
        <Thickness x:Key="MainMenu.ButtonMargin">0,0,0,15</Thickness>
        <Thickness x:Key="MainMenu.LastButtonMargin">0</Thickness>

        <sys:Double x:Key="MainMenu.SettingsButtonSize">64</sys:Double>
        <Thickness x:Key="MainMenu.SettingsMargin">30,0,30,40</Thickness>
        <Thickness x:Key="MainMenu.TitleMargin">0,0,0,20</Thickness>
    </UserControl.Resources>

    <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                CornerRadius="{StaticResource MainMenu.BorderCornerRadius}"
                Background="{StaticResource Brush.Bg}"
                Padding="{StaticResource MainMenu.BorderPadding}">

            <StackPanel MinWidth="{StaticResource MainMenu.ContainerMinWidth}"
                        HorizontalAlignment="Center">

                <TextBlock Text="{Binding [AppTitle], Source={x:Static localization:LocalizationProvider.Instance}}"
                           Style="{StaticResource Txt.Pixel}"
                           Foreground="{StaticResource Brush.Accent}"
                           FontSize="{StaticResource MainMenu.TitleFontSize}"
                           HorizontalAlignment="Center"
                           Margin="{StaticResource MainMenu.TitleMargin}"/>

                <Button x:Name="btnPlay"
                        Content="{Binding [BtnPlay], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Command="{Binding PlayCommand}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="{StaticResource MainMenu.ButtonMinWidth}"
                        Height="{StaticResource MainMenu.ButtonHeight}"
                        Margin="{StaticResource MainMenu.ButtonMargin}"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="btnLeaderboards"
                        Content="{Binding [BtnLeaderboards], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Command="{Binding LeaderboardsCommand}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="{StaticResource MainMenu.ButtonMinWidth}"
                        Height="{StaticResource MainMenu.ButtonHeight}"
                        Margin="{StaticResource MainMenu.ButtonMargin}"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="btnProfile"
                        Content="{Binding [BtnProfile], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Command="{Binding ProfileCommand}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="{StaticResource MainMenu.ButtonMinWidth}"
                        Height="{StaticResource MainMenu.ButtonHeight}"
                        Margin="{StaticResource MainMenu.ButtonMargin}"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="btnFriends"
                        Content="{Binding [BtnFriends], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Command="{Binding FriendsCommand}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="{StaticResource MainMenu.ButtonMinWidth}"
                        Height="{StaticResource MainMenu.ButtonHeight}"
                        Margin="{StaticResource MainMenu.ButtonMargin}"
                        HorizontalAlignment="Stretch"/>

                <Button x:Name="btnExit"
                        Content="{Binding [BtnExit], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Command="{Binding ExitCommand}"
                        Style="{StaticResource Btn.Primary}"
                        MinWidth="{StaticResource MainMenu.ButtonMinWidth}"
                        Height="{StaticResource MainMenu.ButtonHeight}"
                        Margin="{StaticResource MainMenu.LastButtonMargin}"
                        HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Button x:Name="btnSettings"
                ToolTip="{Binding [TooltipSettings], Source={x:Static localization:LocalizationProvider.Instance}}"
                Command="{Binding SettingsCommand}"
                Style="{StaticResource Btn.Primary}"
                Width="{StaticResource MainMenu.SettingsButtonSize}"
                Height="{StaticResource MainMenu.SettingsButtonSize}"
                Foreground="{StaticResource Brush.Bg}"
                Margin="{StaticResource MainMenu.SettingsMargin}"
                VerticalAlignment="Bottom"
                HorizontalAlignment="Right"
                Panel.ZIndex="3">
            <Path Style="{StaticResource Icon.Gear}"/>
        </Button>
    </Grid>
</UserControl>