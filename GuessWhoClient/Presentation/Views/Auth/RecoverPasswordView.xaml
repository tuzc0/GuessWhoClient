<UserControl x:Class="GuessWhoClient.Presentation.Views.Auth.RecoverPasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:localization="clr-namespace:GuessWhoClient.Globalization"
             xmlns:behaviors="clr-namespace:GuessWhoClient.Presentation.Behaviors">

    <UserControl.Resources>
        <sys:Double x:Key="HeaderMaxHeight">56</sys:Double>

        <Thickness x:Key="HeaderMargin">0,6,0,6</Thickness>

        <Thickness x:Key="CardPadding">18</Thickness>
        <sys:Double x:Key="CardMaxWidth">640</sys:Double>
        <sys:Double x:Key="CardWidth">543</sys:Double>

        <Thickness x:Key="FooterBackMargin">30,0,0,64</Thickness>

        <sys:Double x:Key="InputHeight">32</sys:Double>
        <sys:Double x:Key="PrimaryButtonHeight">48</sys:Double>
        <sys:Double x:Key="PrimaryButtonWidth">220</sys:Double>
        <sys:Double x:Key="SecondaryButtonWidth">180</sys:Double>
    </UserControl.Resources>

    <Grid Background="{StaticResource Brush.Bg}" Margin="0,0,0,-6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                CornerRadius="16"
                Padding="12"
                HorizontalAlignment="Center"
                Margin="{StaticResource HeaderMargin}"
                MaxWidth="640">
            <Viewbox Stretch="Uniform" MaxHeight="{StaticResource HeaderMaxHeight}">
                <TextBlock Style="{StaticResource Txt.Pixel}"
                           Text="{Binding [UiRecoverPasswordTitle], Source={x:Static localization:LocalizationProvider.Instance}}"
                           Foreground="{StaticResource Brush.Accent}" />
            </Viewbox>
        </Border>

        <Border Grid.Row="1"
                CornerRadius="16"
                Padding="{StaticResource CardPadding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="{StaticResource CardMaxWidth}"
                Width="{StaticResource CardWidth}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,10,0">
                    <StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEmailStepVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Style="{StaticResource Txt.Pixel}"
                                       FontSize="16"
                                       Text="{Binding [LblEmail], Source={x:Static localization:LocalizationProvider.Instance}}"
                                       Margin="0,0,0,4" />

                            <TextBox x:Name="txtEmail"
                                     Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                     MaxLength="254"
                                     Height="{StaticResource InputHeight}"
                                     Style="{StaticResource Input.Pixel}" />
                        </StackPanel>

                        <StackPanel>
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPasswordStepVisible}" Value="True">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Txt.Pixel}"
                                           FontSize="14"
                                           Text="{Binding [LblRecoveryCodeSentTo], Source={x:Static localization:LocalizationProvider.Instance}}"
                                           Margin="0,0,0,2" />
                                <TextBlock Style="{StaticResource Txt.Pixel}"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.Accent}"
                                           Text="{Binding Email}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Txt.Pixel}"
                                           FontSize="16"
                                           Text="{Binding [LblVerificationCode], Source={x:Static localization:LocalizationProvider.Instance}}"
                                           Margin="0,0,0,4" />
                                <TextBox x:Name="txtCode"
                                         Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="6"
                                         Height="{StaticResource InputHeight}"
                                         Style="{StaticResource Input.Pixel}" />
                            </StackPanel>

                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Style="{StaticResource Txt.Pixel}"
                                           FontSize="16"
                                           Text="{Binding [LblPassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <PasswordBox Height="{StaticResource InputHeight}"
                                                 MaxLength="64"
                                                 behaviors:PasswordBoxAssistant.BindPassword="True"
                                                 behaviors:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource Input.Pixel.Password}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>

                                    <TextBox Height="{StaticResource InputHeight}"
                                             MaxLength="64"
                                             Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource Input.Pixel}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,8">
                                <TextBlock Style="{StaticResource Txt.Pixel}"
                                           FontSize="16"
                                           Text="{Binding [LblConfirmPassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                                           Margin="0,0,0,4" />
                                <Grid>
                                    <PasswordBox Height="{StaticResource InputHeight}"
                                                 MaxLength="64"
                                                 behaviors:PasswordBoxAssistant.BindPassword="True"
                                                 behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <PasswordBox.Style>
                                            <Style TargetType="PasswordBox" BasedOn="{StaticResource Input.Pixel.Password}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </PasswordBox.Style>
                                    </PasswordBox>

                                    <TextBox Height="{StaticResource InputHeight}"
                                             MaxLength="64"
                                             Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource Input.Pixel}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPasswordVisible}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </Grid>
                            </StackPanel>

                            <CheckBox Style="{StaticResource Chk.Pixel}"
                                      Content="{Binding [chkShowPasswords], Source={x:Static localization:LocalizationProvider.Instance}}"
                                      Margin="0,4,0,0"
                                      HorizontalAlignment="Left"
                                      IsChecked="{Binding IsPasswordVisible, Mode=TwoWay}" />
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>

                <Grid Grid.Row="1" Margin="0,16,0,0">

                    <StackPanel HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmailStepVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button x:Name="btnSendCode"
                                Content="{Binding [BtnSendCode], Source={x:Static localization:LocalizationProvider.Instance}}"
                                Style="{StaticResource Btn.Primary}"
                                Height="{StaticResource PrimaryButtonHeight}"
                                Width="{StaticResource PrimaryButtonWidth}"
                                HorizontalAlignment="Center"
                                Command="{Binding SendCodeCommand}" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPasswordStepVisible}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <Button x:Name="btnResendCode"
                                Content="{Binding [BtnResendCode], Source={x:Static localization:LocalizationProvider.Instance}}"
                                Style="{StaticResource Btn.Secondary}"
                                Height="{StaticResource PrimaryButtonHeight}"
                                Width="{StaticResource SecondaryButtonWidth}"
                                Margin="0,0,12,0"
                                Command="{Binding ResendCodeCommand}" />

                        <Button x:Name="btnChangePassword"
                                Content="{Binding [BtnChangePassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                                Style="{StaticResource Btn.Primary}"
                                Height="{StaticResource PrimaryButtonHeight}"
                                Width="{StaticResource PrimaryButtonWidth}"
                                Command="{Binding UpdatePasswordCommand}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="2">
            <Button x:Name="btnBack"
                    Style="{StaticResource Btn.Play.Left}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Margin="{StaticResource FooterBackMargin}"
                    Command="{Binding CancelCommand}" />
        </Grid>
    </Grid>
</UserControl>
