<UserControl x:Class="GuessWhoClient.Presentation.Views.Auth.ChangePasswordView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:localization="clr-namespace:GuessWhoClient.Globalization"
             xmlns:behaviors="clr-namespace:GuessWhoClient.Presentation.Behaviors">

    <UserControl.Resources>
        <sys:Double x:Key="Dialog.Width">520</sys:Double>
        <sys:Double x:Key="Dialog.Height">340</sys:Double>

        <sys:Double x:Key="Field.Width">260</sys:Double>
        <sys:Double x:Key="Field.Height">30</sys:Double>

        <GridLength x:Key="Label.ColWidth">190</GridLength>

        <Style x:Key="PasswordBox.HiddenWhenVisible" TargetType="PasswordBox">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TextBox.VisibleWhenVisible" TargetType="TextBox">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPasswordsVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Border Width="{StaticResource Dialog.Width}"
            Height="{StaticResource Dialog.Height}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{StaticResource Brush.Panel}"
            CornerRadius="16"
            Padding="24"
            SnapsToDevicePixels="True">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="16"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="12"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{StaticResource Label.ColWidth}"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Text="{Binding [UiChangePasswordTitle], Source={x:Static localization:LocalizationProvider.Instance}}"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="22"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <CheckBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                      Content="{Binding [chkShowPasswords], Source={x:Static localization:LocalizationProvider.Instance}}"
                      IsChecked="{Binding IsPasswordsVisible}"
                      Style="{StaticResource Chk.Pixel}"
                      HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="3" Grid.Column="0"
                       Text="{Binding [LblCurrentPassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <Grid Grid.Row="3" Grid.Column="1" HorizontalAlignment="Left">
                <PasswordBox Width="{StaticResource Field.Width}"
                             Height="{StaticResource Field.Height}"
                             MaxLength="64"
                             Style="{StaticResource PasswordBox.HiddenWhenVisible}"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding CurrentPassword, Mode=TwoWay}" />
                <TextBox Width="{StaticResource Field.Width}"
                         Height="{StaticResource Field.Height}"
                         MaxLength="64"
                         Style="{StaticResource TextBox.VisibleWhenVisible}"
                         Text="{Binding CurrentPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Grid.Row="5" Grid.Column="0"
                       Text="{Binding [LblNewPassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <Grid Grid.Row="5" Grid.Column="1" HorizontalAlignment="Left">
                <PasswordBox Width="{StaticResource Field.Width}"
                             Height="{StaticResource Field.Height}"
                             MaxLength="64"
                             Style="{StaticResource PasswordBox.HiddenWhenVisible}"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding NewPassword, Mode=TwoWay}" />
                <TextBox Width="{StaticResource Field.Width}"
                         Height="{StaticResource Field.Height}"
                         MaxLength="64"
                         Style="{StaticResource TextBox.VisibleWhenVisible}"
                         Text="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <TextBlock Grid.Row="7" Grid.Column="0"
                       Text="{Binding [LblConfirmNewPassword], Source={x:Static localization:LocalizationProvider.Instance}}"
                       Style="{StaticResource Txt.Pixel}"
                       FontSize="14"
                       VerticalAlignment="Center"/>

            <Grid Grid.Row="7" Grid.Column="1" HorizontalAlignment="Left">
                <PasswordBox Width="{StaticResource Field.Width}"
                             Height="{StaticResource Field.Height}"
                             MaxLength="64"
                             Style="{StaticResource PasswordBox.HiddenWhenVisible}"
                             behaviors:PasswordBoxAssistant.BindPassword="True"
                             behaviors:PasswordBoxAssistant.BoundPassword="{Binding ConfirmPassword, Mode=TwoWay}" />
                <TextBox Width="{StaticResource Field.Width}"
                         Height="{StaticResource Field.Height}"
                         MaxLength="64"
                         Style="{StaticResource TextBox.VisibleWhenVisible}"
                         Text="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="{Binding [BtnCancel], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Width="110" Height="34"
                        Style="{StaticResource Btn.Secondary}"
                        Margin="0,0,10,0"
                        Command="{Binding CancelCommand}"/>
                <Button Content="{Binding [BtnOk], Source={x:Static localization:LocalizationProvider.Instance}}"
                        Width="110" Height="34"
                        Style="{StaticResource Btn.Primary}"
                        Command="{Binding OkCommand}"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
