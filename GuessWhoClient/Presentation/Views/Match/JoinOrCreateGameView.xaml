<UserControl x:Class="GuessWhoClient.Presentation.Views.UserControls.JoinOrCreateGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:GuessWhoClient.Converters">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:StringToVisibilityConverter x:Key="StringToVisibilityConverter" />

        <Style x:Key="ValidationTextBox" TargetType="TextBox">
            <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentDark}" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextLight}" />
            <Setter Property="FontFamily" Value="{StaticResource Font.Pixel}" />
            <Setter Property="Validation.ErrorTemplate">
                <Setter.Value>
                    <ControlTemplate>
                        <DockPanel LastChildFill="True">
                            <Border BorderBrush="{StaticResource Brush.Accent}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Margin="0,0,0,6">
                                <AdornedElementPlaceholder />
                            </Border>

                            <ItemsControl DockPanel.Dock="Bottom"
                                          ItemsSource="{Binding}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Style="{StaticResource Txt.Pixel}"
                                                   FontSize="14"
                                                   Foreground="{StaticResource Brush.Accent}"
                                                   Text="{Binding ErrorContent}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter Property="ToolTip"
                            Value="{Binding RelativeSource={RelativeSource Self},
                                            Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="400">

            <TextBlock Text="Match"
                       Style="{StaticResource Txt.Pixel}"
                       Foreground="{StaticResource Brush.Accent}"
                       FontSize="64"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20"/>

            <Border Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.AccentDark}"
                    BorderThickness="2"
                    CornerRadius="12"
                    Padding="12"
                    Margin="0,0,0,20"
                    Visibility="{Binding UiMessage, Converter={StaticResource StringToVisibilityConverter}}">
                <TextBlock Text="{Binding UiMessage}"
                           Style="{StaticResource Txt.Pixel}"
                           Foreground="{StaticResource Brush.TextLight}"
                           FontSize="16"
                           TextWrapping="Wrap" />
            </Border>

            <Button Content="New Game"
                    Style="{StaticResource Btn.Primary}"
                    Width="350"
                    Height="80"
                    Margin="0,0,0,40"
                    Command="{Binding CreateMatchCommand}"/>

            <TextBlock Text="Code"
                       Style="{StaticResource Txt.Pixel}"
                       Foreground="{StaticResource Brush.Accent}"
                       FontSize="24"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <TextBox Width="350"
                     Height="70"
                     Margin="0,0,0,15"
                     Style="{StaticResource ValidationTextBox}"
                     MaxLength="{Binding MatchCodeMaxLength}"
                     Text="{Binding MatchCodeInput,
                                    UpdateSourceTrigger=PropertyChanged,
                                    ValidatesOnNotifyDataErrors=True,
                                    NotifyOnValidationError=True}" />

            <Button Content="Join Game"
                    Style="{StaticResource Btn.Primary}"
                    Width="350"
                    Height="80"
                    Margin="0,0,0,15"
                    Command="{Binding JoinMatchCommand}"/>

        </StackPanel>

        <Button Style="{StaticResource Btn.Play.Left}"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="40,0,0,40"
                Command="{Binding BackCommand}"/>
    </Grid>
</UserControl>
