<UserControl x:Class="GuessWhoClient.Presentation.Views.UserControls.UpdateProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <Style x:Key="Txt.ReadOnly" TargetType="TextBlock" BasedOn="{StaticResource Txt.Pixel}">
                <Setter Property="FontSize" Value="18" />
            </Style>
            <SolidColorBrush x:Key="Brush.CardFrameOuter" Color="#A86105"/>
            <SolidColorBrush x:Key="Brush.CardFrameInner" Color="#F39C12"/>
            <SolidColorBrush x:Key="Brush.CardInside" Color="#F3C46A"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="40">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="290" />
            <ColumnDefinition Width="32" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="2" CornerRadius="20" Background="{StaticResource Brush.CardFrameOuter}" BorderBrush="#3B1C09" BorderThickness="4" Padding="6">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="4" Direction="315" Opacity="0.8" Color="#99000000"/>
            </Border.Effect>
            <Border CornerRadius="16" Background="{StaticResource Brush.CardFrameInner}" Padding="8">
                <Grid>
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="90" />
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" CornerRadius="10" Background="{StaticResource Brush.CardInside}" BorderBrush="#C9A26C" BorderThickness="2" Margin="2,2,2,8">
                            <Grid Margin="8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Image Source="{Binding AvatarImageSource}" Width="172" Height="172" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Clip>
                                        <EllipseGeometry Center="86,86" RadiusX="86" RadiusY="86"/>
                                    </Image.Clip>
                                </Image>
                                <Button Grid.Row="1" Content="Change" Style="{StaticResource Btn.Primary}" Width="140" Height="36" 
                                        Command="{Binding ChangeAvatarCommand}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>
                        <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource Brush.CardInside}" BorderBrush="#8C5521" BorderThickness="2">
                            <TextBlock Text="{Binding DisplayName}" Style="{StaticResource Txt.Pixel}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Grid Grid.Column="4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="Profile" Style="{StaticResource Txt.Pixel}" FontSize="24" />

            <Grid Grid.Row="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Text="Display name" Style="{StaticResource Txt.ReadOnly}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Height="30"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding DisplayName}" Style="{StaticResource Txt.ReadOnly}" VerticalAlignment="Center"
                           Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}, ConverterParameter=Inverse}"/>

                <TextBlock Grid.Row="2" Text="Email" Style="{StaticResource Txt.ReadOnly}" VerticalAlignment="Center" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Email}" Style="{StaticResource Txt.ReadOnly}" VerticalAlignment="Center"/>

                <TextBlock Grid.Row="4" Text="Password" Style="{StaticResource Txt.ReadOnly}" VerticalAlignment="Center" />
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock Text="********" Style="{StaticResource Txt.Pixel}" FontSize="16" VerticalAlignment="Center"/>
                    <Button Content="Change Password" Command="{Binding OpenPasswordModalCommand}" Margin="15,0,0,0"
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Style="{StaticResource Btn.Secondary}" Height="30"/>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="4" Margin="0,20,0,0">
                <Button Content="Delete Account" Command="{Binding DeleteAccountCommand}" HorizontalAlignment="Left" Style="{StaticResource Btn.Secondary}" 
                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Width="140" Height="36"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{Binding EditButtonText}" Command="{Binding EditSaveCommand}" Style="{StaticResource Btn.Primary}" Width="120" Height="36" Margin="0,0,10,0"/>
                    <Button Content="Cancel" Command="{Binding CancelCommand}" Style="{StaticResource Btn.Secondary}" 
                            Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" Width="100" Height="36"/>
                </StackPanel>
            </Grid>
        </Grid>

        <Button Grid.Column="0" VerticalAlignment="Bottom" Command="{Binding BackCommand}" Style="{StaticResource Btn.Play.Left}"/>

        <Grid Grid.ColumnSpan="5" Background="#AA000000" Visibility="{Binding IsPasswordModalVisible, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Width="350" VerticalAlignment="Center" Background="{StaticResource Brush.CardInside}" CornerRadius="10" Padding="20" BorderBrush="#3B1C09" BorderThickness="3">
                <StackPanel>
                    <TextBlock Text="CHANGE PASSWORD" Style="{StaticResource Txt.Pixel}" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <TextBlock Text="Current Password:" FontSize="12"/>
                    <TextBox Text="{Binding CurrentPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10" Height="25"/>
                    <TextBlock Text="New Password:" FontSize="12"/>
                    <TextBox Text="{Binding NewPassword, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,20" Height="25"/>
                    <Button Content="Accept" Command="{Binding ClosePasswordModalCommand}" Style="{StaticResource Btn.Primary}" Height="30"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="5" Background="#44000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" Panel.ZIndex="200">
            <TextBlock Text="SYNCING..." Foreground="White" Style="{StaticResource Txt.Pixel}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>