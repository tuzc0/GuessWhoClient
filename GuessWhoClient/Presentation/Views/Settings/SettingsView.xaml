<UserControl x:Class="GuessWhoClient.Presentation.Views.Settings.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:localization="clr-namespace:GuessWhoClient.Globalization">

    <Grid Margin="24">
        <Border CornerRadius="16"
                Padding="24"
                Background="{StaticResource Brush.Bg}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Style="{StaticResource Txt.Pixel}"
                           Foreground="{StaticResource Brush.Accent}"
                           FontSize="26"
                           Text="{Binding [SettingsTitle], Source={x:Static localization:LocalizationProvider.Instance}}"/>

                <TextBlock Grid.Row="2"
                           Style="{StaticResource Txt.Pixel}"
                           FontSize="18"
                           Foreground="{StaticResource Brush.Accent}"
                           Text="{Binding [SettingsLanguageLabel], Source={x:Static localization:LocalizationProvider.Instance}}"/>

                <StackPanel Grid.Row="4" Orientation="Vertical">
                    <RadioButton GroupName="Lang"
                                 Foreground="{StaticResource Brush.Accent}"
                                 IsChecked="{Binding IsEnglishSelected, Mode=TwoWay}"
                                 Content="{Binding [SettingsLanguageEnglish], Source={x:Static localization:LocalizationProvider.Instance}}"/>

                    <RadioButton GroupName="Lang"
                                 Margin="0,8,0,0"
                                 Foreground="{StaticResource Brush.Accent}"
                                 IsChecked="{Binding IsSpanishSelected, Mode=TwoWay}"
                                 Content="{Binding [SettingsLanguageSpanishMx], Source={x:Static localization:LocalizationProvider.Instance}}"/>

                    <RadioButton GroupName="Lang"
                                 Margin="0,8,0,0"
                                 Foreground="{StaticResource Brush.Accent}"
                                 IsChecked="{Binding IsFrenchSelected, Mode=TwoWay}"
                                 Content="{Binding [SettingsLanguageFrench], Source={x:Static localization:LocalizationProvider.Instance}}"/>

                    <RadioButton GroupName="Lang"
                                 Margin="0,8,0,0"
                                 Foreground="{StaticResource Brush.Accent}"
                                 IsChecked="{Binding IsItalianSelected, Mode=TwoWay}"
                                 Content="{Binding [SettingsLanguageItalian], Source={x:Static localization:LocalizationProvider.Instance}}"/>
                </StackPanel>

                <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="140" Height="44"
                            Margin="0,0,12,0"
                            Style="{StaticResource Btn.Primary}"
                            Content="{Binding [BtnCancel], Source={x:Static localization:LocalizationProvider.Instance}}"
                            Command="{Binding CancelCommand}"/>

                    <Button Width="140" Height="44"
                            Style="{StaticResource Btn.Primary}"
                            Content="{Binding [BtnApply], Source={x:Static localization:LocalizationProvider.Instance}}"
                            Command="{Binding ApplyCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
